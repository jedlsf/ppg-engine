{
  "name": "ppg-engine",
  "version": "0.1.0",
  "description": "A TypeScript library for cube-facelet state, modular polynomial values, and reversible geometric and algebraic transformations.",
  "type": "module",
  "license": "MIT",
  "author": "Zelijah",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/core/geometry/index.d.ts",
      "import": "./dist/core/geometry/index.js",
      "default": "./dist/core/geometry/index.js"
    },
    "./polynomial": {
      "types": "./dist/core/polynomial/index.d.ts",
      "import": "./dist/core/polynomial/index.js",
      "default": "./dist/core/polynomial/index.js"
    },
    "./transform": {
      "types": "./dist/core/transform/index.d.ts",
      "import": "./dist/core/transform/index.js",
      "default": "./dist/core/transform/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jedlsf/ppg-engine.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "keywords": [
    "ppg",
    "polynomial-permutation-geometry",
    "geometry",
    "cube-geometry",
    "facelet",
    "polynomial",
    "polynomial-ring",
    "modular-arithmetic",
    "permutation",
    "reversible-transformations",
    "state-transformation",
    "puzzle-engine",
    "typescript",
    "algebra"
  ],
  "homepage": "https://github.com/jedlsf/ppg-engine#readme",
  "bugs": {
    "url": "https://github.com/jedlsf/ppg-engine/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:geometry": "vitest run tests/geometry",
    "test:polynomial": "vitest run tests/polynomial",
    "test:transform": "vitest run tests/transform",
    "test:engine": "vitest run tests/engine",
    "check": "npm run typecheck && npm test && npm run build",
    "test:integration": "vitest run tests/integration tests/engine/ppg-engine.integration.test.ts tests/transform/integration.test.ts",
    "test:security": "vitest run tests/geometry/security-validation.test.ts tests/polynomial/adversarial.test.ts",
    "test:layers": "vitest run tests/geometry tests/polynomial tests/transform tests/engine tests/integration"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
